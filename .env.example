# Copy to .env. The API runs fully mocked with NONE of these set.
PORT=3000
MOCK=1

# Filled in as each route goes real (see the commit roadmap in CLAUDE.md):
ANTHROPIC_API_KEY=      # COMMIT-3  task generation
FAL_KEY=               # COMMIT-3/4 media storage + image-to-video (render pipeline)
ELEVENLABS_AGENT_ID=   # COMMIT-2  the Regisseur voice agent
ELEVENLABS_API_KEY=    # COMMIT-2
N8N_WEBHOOK_URL=       # COMMIT-5  publish → YouTube Short

# Render pipeline (COMMIT-4). Works with no keys via local ffmpeg; set FAL_KEY to
# route through fal image-to-video + storage.
FAL_I2V_MODEL=fal-ai/kling-video/v1/standard/image-to-video
FAL_I2V_DURATION=5      # kling accepts "5" or "10"
FAL_TTS_MODEL=          # optional fal narration model; empty → local `say`/silent
PUBLIC_BASE_URL=        # optional absolute base for returned render URLs
